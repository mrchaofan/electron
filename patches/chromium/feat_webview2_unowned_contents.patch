@@ -8,6 +8,10 @@
 #include "base/types/pass_key.h"
 #include "content/common/content_export.h"
 
+namespace electron {
+class UnownedWebContentsBridge;
+}
+
 namespace guest_contents {
 class GuestContentsHandle;
 }  // namespace guest_contents
@@ -30,6 +34,7 @@ class CONTENT_EXPORT UnownedInnerWebContentsClient {
 
  private:
   friend class guest_contents::GuestContentsHandle;
+  friend class electron::UnownedWebContentsBridge;
 
   static PassKey GetPassKey();
 };
diff --git a/content/public/browser/web_contents_observer.h b/content/public/browser/web_contents_observer.h
index 11e0c023f3..0b6c52dee3 100644
--- a/content/public/browser/web_contents_observer.h
+++ b/content/public/browser/web_contents_observer.h
@@ -713,6 +713,10 @@ class CONTENT_EXPORT WebContentsObserver : public base::CheckedObserver {
   virtual void InnerWebContentsAttached(WebContents* inner_web_contents,
                                         RenderFrameHost* render_frame_host) {}
 
+  // Called after complete unowned detach, including automatic frame teardown.
+  // Observers must not reenter attach/destroy or retain the inner pointer.
+  virtual void UnownedInnerWebContentsDetached(WebContents* inner) {}
+
   // Called when a SurfaceEmbed child WebContents is attached to its embedder.
   // `inner_web_contents` is the child WebContents. `embedder_render_frame_host`
   // is the outer document's RenderFrameHost that embeds it.
