+void InputHandler::CancelIsolatedMouseSequence() {
+  auto press = std::move(isolated_mouse_press_);
+  auto view = isolated_mouse_target_;
+  isolated_mouse_target_.reset();
+  if (!press || !view || !host_ ||
+      host_->GetDocumentToken() != isolated_mouse_document_)
+    return;
+
+  auto* widget = RenderWidgetHostImpl::From(view->GetRenderWidgetHost());
+  if (!widget || widget->frame_tree() != host_->frame_tree())
+    return;
+
+  press->SetType(blink::WebInputEvent::Type::kMouseUp);
+  press->SetModifiers(press->GetModifiers() &
+                      ~blink::WebInputEvent::kLeftButtonDown);
+  press->click_count = 0;
+  press->SetPositionInWidget(gfx::PointF(-1, -1));
+  widget->ForwardMouseEvent(*press);
+}
