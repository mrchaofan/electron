+bool InputHandler::ShouldIsolateDebuggerInput() {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+  if (!web_contents_ || !web_contents_->GetOuterWebContents())
+    return false;
+
+  auto enabled = [](DevToolsSession* session) {
+    if (!session) {
+      return false;
+    }
+    auto it = session->handlers().find(Emulation::Metainfo::domainName);
+    return it != session->handlers().end() &&
+           static_cast<EmulationHandler*>(it->second.get())
+               ->focus_emulation_enabled();
+  };
+  if (enabled(session())) {
+    return true;
+  }
+  auto* root = session() ? session()->GetRootSession() : nullptr;
+  return root && root != session() && root->GetAgentHost() &&
+         root->GetAgentHost()->GetWebContents() == web_contents_ &&
+         enabled(root);
+#else
+  return false;
+#endif
+}
+
+// Debugger keyboard commands address their own page/frame, independently of
+// the embedding root's real keyboard focus. Frame focus stays inside this tree.
+RenderWidgetHostImpl* InputHandler::ResolveKeyboardWidget(
+    bool isolate_focus, bool include_child_frame_focus) {
+  if (!isolate_focus) {
+    auto* widget = host_->GetRenderWidgetHost();
+    if ((include_child_frame_focus || !host_->GetParent()) && widget->delegate()) {
+      if (auto* focused = widget->delegate()->GetFocusedRenderWidgetHost(widget))
+        return focused;
+    }
+    return widget;
+  }
+
+  if (!host_ || !host_->IsActive() || !host_->IsRenderFrameLive()) {
+    return nullptr;
+  }
+
+  auto* frame = host_.get();
+  if (!frame->GetParent()) {
+    auto* node = web_contents_->GetPrimaryFrameTree().GetFocusedFrame();
+    frame = node ? node->current_frame_host()
+                 : web_contents_->GetPrimaryMainFrame();
+  }
+  if (!frame->IsActive() || !frame->IsRenderFrameLive())
+    return nullptr;
+
+  auto self = weak_factory_.GetWeakPtr();
+  auto session_frame = host_->GetWeakPtr();
+  auto target = frame->GetWeakPtr();
+  const auto document = frame->GetDocumentToken();
+  frame->frame_tree()->SetFocusedFrame(frame->frame_tree_node(), nullptr);
+  if (!self || self->host_ != session_frame.get() || !target ||
+      !target->IsActive() || !target->IsRenderFrameLive() ||
+      target->GetDocumentToken() != document) {
+    return nullptr;
+  }
+  return target->GetRenderWidgetHost();
+}
